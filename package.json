    "./sdk": "./sdk/index.js",
    "./sdk/adapters": "./sdk/adapters.js"
  },
  "optionalDependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9"
  }
